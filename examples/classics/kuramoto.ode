# The Kuramoto model
# Ten oscillators with different natural frequencies, each pulled towards
# the others. With enough coupling K they fall into step: the order
# parameter r rises from near 0 to near 1 (Kuramoto, 1975).
par K=2
w[1..10]=-1.125+0.225*[j]
cx=sum(0,9)of(cos(shift(th1,i')))/10
sx=sum(0,9)of(sin(shift(th1,i')))/10
th[1..10]'=w[j]+K*(sx*cos(th[j])-cx*sin(th[j]))
aux r=sqrt(cx^2+sx^2)
init th1=0,th2=2.5,th3=5,th4=1.2,th5=3.7,th6=0.6,th7=4.4,th8=1.9,th9=5.6,th10=3.1
@ total=40,dt=0.01,meth=rungekutta
@ xp=t,yp=r,xlo=0,xhi=40,ylo=0,yhi=1
done
