// Windows resources: the application icon, the manifest and version
// information.
#include <winver.h>

1 ICON "icon.ico"

// The application manifest (resource type 24, RT_MANIFEST, number 1): the
// UTF-8 code page, so that file names with non-ASCII letters open.
1 24 "xpplab.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,1,1,0
PRODUCTVERSION 0,1,1,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "XPP Lab - dynamical systems and bifurcation analysis"
      VALUE "ProductName", "XPP Lab"
      VALUE "FileVersion", "0.1.1"
      VALUE "ProductVersion", "0.1.1"
      VALUE "LegalCopyright", "GPL-2.0-or-later. Engine: XPPAUT by G. B. Ermentrout."
      VALUE "OriginalFilename", "xpplab.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
